+  function honestFloorFace(definition, parts, proofClass, sourceBlob) {
+    const face = { measurement: parts.measurement, status: parts.status, state: parts.state };
+    // F5 already says "policy constant · not measured" in floorParts. Do not rewrite it.
+    if (definition.id === 'F5') return face;
+    const blob = String(sourceBlob || '');
+    const proof = String(proofClass || '');
+    const policy = blob.includes('POLICY_CONSTANT') || proof.includes('POLICY_CONSTANT');
+    const presence = proof === 'presence_only' || proof.includes('presence_only');
+    if (policy || presence) {
+      face.measurement = (presence && !policy) ? 'presence only · not measured' : 'policy constant · not measured';
+      face.status = (presence && !policy) ? 'presence only · verdict withheld' : 'constant · not measured';
+      face.state = 'unknown';
+    }
+    return face;
+  }
