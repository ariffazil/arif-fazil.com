{
  "$schema": "./public-state.schema.json",
  "schema": "canon/design-tokens/v2026.08",
  "version": "ARROW-2.0",
  "primer": "ARROW-DARK",
  "ratified_by": "sovereign (F13)",
  "ratified_at": "2026-08-01",
  "updated_at": "2026-08-09",
  "doctrine": "One canon, two renderings. Every human token has a machine twin. Design is the F4 Clarity floor made visible. Red is rationed - maruah is scarce by definition. DARK basalt unified with GEOX.",
  "note": "PRIMER-1 light palette retired 2026-08-09. Arrow Dark is the live system. Update tailwind.config.js and index.css to match these tokens.",
  "color": {
    "human": {
      "family": "yellow",
      "rationale": "Warmth. Gold accent on dark basalt — geological, restrained.",
      "500": { "hex": "#C9A227", "name": "gold", "use": "brand accent, quotes, gold family" },
      "700": { "hex": "#B08D3E", "name": "brass", "use": "editorial accent" },
      "900": { "hex": "#4A3608", "name": "umber", "use": "deep accent" }
    },
    "institution": {
      "family": "blue",
      "rationale": "Law. Muted blue on dark — institutional trust without brightness.",
      "300": { "hex": "#7DD3FC", "name": "cold", "use": "data highlights" },
      "500": { "hex": "#31c48d", "name": "forge-green", "use": "seal/live status" },
      "700": { "hex": "#1B3A57", "name": "deep marine", "use": "text on accent" }
    },
    "earth": {
      "family": "green-blue",
      "rationale": "Geologic. Teal to viridian — basin green on dark.",
      "500": { "hex": "#FF9F1C", "name": "earth-orange", "use": "earth family accent" },
      "700": { "hex": "#17584A", "name": "basin", "use": "text on accent" },
      "900": { "hex": "#0A2E27", "name": "trench", "use": "deep accent" }
    },
    "sovereign": {
      "family": "red",
      "rationale": "Rationed. Red appears only where sovereignty or judgment is present. If red is everywhere, it means nothing.",
      "300": { "hex": "#D97B6C", "name": "clay", "use": "seal backgrounds only" },
      "500": { "hex": "#f0506e", "name": "signal", "use": "verdicts, 888, warnings, void/hazard" },
      "700": { "hex": "#7A1F18", "name": "maroon", "use": "sovereign text/strip" },
      "900": { "hex": "#3D0E0A", "name": "deep scar", "use": "VOID state" }
    },
    "neutral": {
      "family": "neutral",
      "rationale": "Bedrock. Dark basalt canvas with warm ink text.",
      "paper": { "hex": "#0A0B0D", "name": "basalt canvas", "use": "primary background (dark)" },
      "paper-dark": { "hex": "#111318", "name": "steel surface", "use": "cards, elevated surfaces" },
      "ink": { "hex": "#EDEAE2", "name": "warm ink", "use": "primary text" },
      "ink-soft": { "hex": "#9AA0A8", "name": "dim ink", "use": "secondary text" },
      "carbon": { "hex": "#0A0C10", "name": "forge carbon", "use": "forge palette base" },
      "bone": { "hex": "#E6EDF3", "name": "bone text", "use": "forge palette primary text" },
      "border": { "hex": "#1f2733", "name": "hairline", "use": "borders" }
    }
  },
  "font": {
    "family": "Arrow-Type",
    "voices": { "display": "Fraunces", "body": "Newsreader", "machine": "IBM Plex Mono" },
    "note": "Satoshi/Cabinet Grotesk loaded but unused — remove from index.html to save 200KB+ download.",
    "scale_ratio": 1.414,
    "base_px": 16.8,
    "scale": {
      "t--1": { "px": 11.9, "use": "captions, vault refs (mono)" },
      "t-0": { "px": 16.8, "use": "body" },
      "t+1": { "px": 23.8, "use": "section titles" },
      "t+2": { "px": 33.6, "use": "page titles" },
      "t+3": { "px": 47.6, "use": "trinity tile heroes" }
    },
    "line_height": { "body": 1.5, "title": 1.15 },
    "measure_chars": 68,
    "tnum": "font-feature-settings: tnum"
  },
  "geometry": {
    "unit_px": 4,
    "spacing": [1, 2, 4, 8, 16, 32, 64],
    "grid": { "columns": 12, "breakpoints": [640, 1024, 1440] },
    "radius": { "human": 12, "machine": 2, "torus": "full" },
    "motif": {
      "notch": "fractal-corner-8-4-2",
      "ring": "trinity-torus",
      "wheel": "mission-torus"
    },
    "border": { "width": 1, "token_level": 300, "dashed_only_for": "888_HOLD" }
  },
  "motion": {
    "travel_ms": 90,
    "easing": "cubic-bezier(.2,.9,.3,1)",
    "press_travel_px": 2,
    "hold_to_confirm_ms": 800,
    "reduced_motion": "collapse all travel to opacity-only"
  },
  "buttons": {
    "grades": {
      "SEAL": { "look": "solid *-500, ink text, 2px travel shadow in *-700", "use": "one per view - committing action" },
      "HOLD": { "look": "paper fill, 1px *-500 border, dashed on hover", "use": "pending, reversible, draft" },
      "VOID": { "look": "r-500 fill - the only red button", "use": "irreversible; hold-to-confirm 800ms" }
    },
    "states": {
      "REST": { "transform": "translateY(0)", "shadow": "0 2px 0 family-700" },
      "HOVER": { "transform": "translateY(-1px)", "shadow": "0 3px 0 family-700" },
      "ACTIVE": { "transform": "translateY(2px)", "shadow": "0 0 0 + inset 0 2px 4px" },
      "DISABLED": { "opacity": 0.45, "shadow": "none", "cursor": "not-allowed" }
    }
  },
  "verdict_chips": {
    "999_SEAL": { "look": "solid family-500", "font": "mono uppercase", "radius": "machine" },
    "888_HOLD": { "look": "dashed r-500 border", "font": "mono uppercase", "radius": "machine" },
    "VOID": { "look": "solid r-900", "font": "mono uppercase", "radius": "machine" }
  },
  "territory_map": {
    "/human": "human",
    "/institution": "institution",
    "/earth": "earth",
    "/arif": "sovereign",
    "/laws": "doctrine",
    "/world/oil": "institution",
    "/world/gas": "institution",
    "/world/gold": "institution",
    "/999": "sovereign",
    "/000": "sovereign"
  },
  "machine_twin": {
    "channel_field": "channel",
    "state_enum": ["rest", "hold", "sealed", "void"],
    "schema_version": "canon/v2026.08"
  },
  "contrast_guarantees": {
    "action_500_vs_100_bg": "WCAG AA >= 4.5:1",
    "text_700_900_vs_bg": "WCAG AAA >= 7:1",
    "enforced_by": "CI token lint (F4 at build time)"
  }
}
